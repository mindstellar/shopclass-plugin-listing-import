{
  "openapi": "3.1.0",
  "info": {
    "title": "Shopclass Listing Import API",
    "version": "1",
    "description": "Send listings to a Shopclass site. Every request but ping and this file needs an API key made under Plugins → Listing import: API keys, sent as `Authorization: Bearer <key>`. Each key has permissions (scopes) and a limit of requests per minute.",
    "license": {
      "name": "GPL-3.0-or-later"
    }
  },
  "servers": [
    {
      "url": "{site}/api/v1",
      "variables": {
        "site": {
          "default": "https://example.com",
          "description": "Your site. With friendly URLs off, use {site}/index.php?page=route&route=listing-import-api&path=<endpoint> instead."
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The key shown once when it is made: <key id>.<secret>."
      }
    },
    "schemas": {
      "Record": {
        "type": "object",
        "required": [
          "external_id",
          "title",
          "description"
        ],
        "properties": {
          "external_id": {
            "type": "string",
            "maxLength": 191,
            "description": "Your id. The same id updates the same listing."
          },
          "title": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "description": "Locale code => text, e.g. {\"en_US\": \"Bike\"}",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "description": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "description": "Locale code => text, e.g. {\"en_US\": \"Bike\"}",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "category": {
            "description": "An id, a slug, a path such as \"Vehicles > Bikes\", or an object with one of id, slug, path, label. Optional when the source has a default category.",
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "slug": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "price": {
            "type": "object",
            "required": [
              "amount"
            ],
            "properties": {
              "amount": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "description": "Such as \"1.234,50\" or \"€ 650\"."
                  }
                ]
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            }
          },
          "location": {
            "type": "object",
            "properties": {
              "country": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "city_area": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "zip": {
                "type": "string"
              },
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            }
          },
          "contact": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "phone": {
                "type": "string"
              },
              "show_email": {
                "type": "boolean"
              }
            }
          },
          "owner": {
            "type": "object",
            "description": "One of user_id or email of an account on the site.",
            "properties": {
              "user_id": {
                "type": "integer",
                "minimum": 1
              },
              "email": {
                "type": "string",
                "format": "email"
              }
            }
          },
          "images": {
            "description": "One image address, or a list of up to 20.",
            "oneOf": [
              {
                "type": "string",
                "format": "uri",
                "description": "A public http or https address. JPEG, PNG, GIF or WebP, up to 8 MB."
              },
              {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "description": "A public http or https address. JPEG, PNG, GIF or WebP, up to 8 MB."
                }
              }
            ]
          },
          "fields": {
            "type": "object",
            "description": "Custom field slug => value.",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Warnings": {
        "type": "object",
        "description": "Field path => what was ignored or guessed. The record was still imported.",
        "additionalProperties": {
          "type": "string"
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "unauthorized, forbidden, not_found, method_not_allowed, rate_limited, too_large, unsupported_media_type, invalid_json, not_imported, not_deleted, invalid_batch, too_many_records, id_mismatch, no_source, server_error"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "description": "Field path => the problem, for a record that was refused.",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "An error. 429 carries Retry-After.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/ping": {
      "get": {
        "summary": "Check the API answers",
        "description": "No key needed.",
        "responses": {
          "200": {
            "description": "The plugin and its version."
          }
        },
        "security": []
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This description",
        "description": "No key needed.",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1."
          }
        },
        "security": []
      }
    },
    "/listings": {
      "post": {
        "summary": "Import one listing",
        "description": "Creates a listing, updates the one this external id made before, or changes nothing when the record is the same. Images are fetched now, up to 10.",
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "created",
                            "updated",
                            "unchanged"
                          ]
                        },
                        "external_id": {
                          "type": "string"
                        },
                        "item_id": {
                          "type": "integer"
                        },
                        "run_id": {
                          "type": "integer"
                        }
                      }
                    },
                    "warnings": {
                      "$ref": "#/components/schemas/Warnings"
                    }
                  }
                }
              }
            }
          },
          "200": {
            "description": "Updated or unchanged.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "created",
                            "updated",
                            "unchanged"
                          ]
                        },
                        "external_id": {
                          "type": "string"
                        },
                        "item_id": {
                          "type": "integer"
                        },
                        "run_id": {
                          "type": "integer"
                        }
                      }
                    },
                    "warnings": {
                      "$ref": "#/components/schemas/Warnings"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-scope": "listings:write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Record"
              }
            }
          }
        }
      }
    },
    "/listings:batch": {
      "post": {
        "summary": "Import up to 200 listings in the background",
        "description": "Answers at once with a run id; each record is imported by the site's background jobs. Follow it with GET /runs/{id}.",
        "responses": {
          "202": {
            "description": "Queued.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "run_id": {
                          "type": "integer"
                        },
                        "records": {
                          "type": "integer"
                        },
                        "status": {
                          "const": "queued"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-scope": "listings:write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "records"
                ],
                "properties": {
                  "records": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "items": {
                      "$ref": "#/components/schemas/Record"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/listings/{external_id}": {
      "get": {
        "summary": "Where one listing stands",
        "description": "The listing this external id became, its address, and whether it is still live.",
        "responses": {
          "200": {
            "description": "The listing."
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-scope": "listings:write",
        "parameters": [
          {
            "name": "external_id",
            "in": "path",
            "required": true,
            "description": "Your id for the listing. It cannot contain a slash.",
            "schema": {
              "type": "string",
              "maxLength": 191
            }
          }
        ]
      },
      "put": {
        "summary": "Create or replace one listing",
        "description": "The whole record; the external id comes from the address. There is no partial update: send the whole record again.",
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "created",
                            "updated",
                            "unchanged"
                          ]
                        },
                        "external_id": {
                          "type": "string"
                        },
                        "item_id": {
                          "type": "integer"
                        },
                        "run_id": {
                          "type": "integer"
                        }
                      }
                    },
                    "warnings": {
                      "$ref": "#/components/schemas/Warnings"
                    }
                  }
                }
              }
            }
          },
          "200": {
            "description": "Updated or unchanged.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "created",
                            "updated",
                            "unchanged"
                          ]
                        },
                        "external_id": {
                          "type": "string"
                        },
                        "item_id": {
                          "type": "integer"
                        },
                        "run_id": {
                          "type": "integer"
                        }
                      }
                    },
                    "warnings": {
                      "$ref": "#/components/schemas/Warnings"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-scope": "listings:write",
        "parameters": [
          {
            "name": "external_id",
            "in": "path",
            "required": true,
            "description": "Your id for the listing. It cannot contain a slash.",
            "schema": {
              "type": "string",
              "maxLength": 191
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Record"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete one listing",
        "description": "Deletes the listing this external id made. Only this request deletes a listing; a feed never does.",
        "responses": {
          "200": {
            "description": "Deleted."
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-scope": "listings:delete",
        "parameters": [
          {
            "name": "external_id",
            "in": "path",
            "required": true,
            "description": "Your id for the listing. It cannot contain a slash.",
            "schema": {
              "type": "string",
              "maxLength": 191
            }
          }
        ]
      }
    },
    "/runs/{id}": {
      "get": {
        "summary": "How a run went",
        "description": "Counts, whether it has finished, and each failed record with its reasons. A key sees only runs of its own source.",
        "responses": {
          "200": {
            "description": "The run."
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "x-scope": "runs:read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    }
  }
}
